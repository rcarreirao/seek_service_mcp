    "version": "0.2.0",
    "gopls": {"ur.semanticToken": true},
    "configurations": [
        {
            "name": "Go Rpl",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "backend/main.go",
            "args": [""],
            "cwd": "${workspaceFolder}/backend"
        },
        {
            "name": "Go Rpl Seed",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "backend/main.go",
            "args": ["artisan", "db:seed"],
            "cwd": "${workspaceFolder}/backend"
        },
        {
            "name": "Go Rpl Test",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${file}",
            "args": ["-tags", "integration", "-v"],
            "cwd": "${workspaceFolder}/backend"
        }
    ]
}